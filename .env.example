# Supabase project URL used by the Vite client.
VITE_SUPABASE_URL=

# Supabase anon/public key used by the Vite client.
VITE_SUPABASE_ANON_KEY=

# Public app URL used for auth email redirects.
VITE_APP_URL=

# Public OAuth Web client ID from Google Cloud. Do not use the client secret in Vite.
VITE_GOOGLE_CLIENT_ID=
